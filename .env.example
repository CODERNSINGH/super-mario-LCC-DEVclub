# ── Evaluation / headless (make run, make solve) ─────────────────────────────
# The credential is read from the ENVIRONMENT at runtime. Never commit a real key.
#   export AI_API_KEY="<your key>"
AI_API_KEY=
AI_PROVIDER=                # optional; auto-detected from the key. deepseek | qwen | qwen-cn | groq | openai | anthropic | ollama
AI_MODEL=                   # optional; default: deepseek-v4-pro / qwen3.8-max / ...
AI_BASE_URL=                # optional custom endpoint
GITHUB_TOKEN=               # optional: private repos / PRs in headless mode

# ── GitHub (required) ─────────────────────────────────────────────
# OAuth App with "Enable Device Flow" ticked. Client ID only, no secret needed.
SAKAI_GITHUB_CLIENT_ID=

# ── LLM providers (optional defaults; users can also paste keys in-app) ──
GROQ_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=       # Qwen via Alibaba DashScope
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Local models ──────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
LMSTUDIO_HOST=http://localhost:1234/v1

# ── Server ────────────────────────────────────────────────────────
SAKAI_SERVER_PORT=4477
