{
  "name": "@sakai/app",
  "private": true,
  "version": "0.1.0",
  "main": "out/main/index.js",
  "description": "Sakai IDE \u2014 autonomous AI coding agent for GitHub issues",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --mac",
    "postinstall": "electron-rebuild -f -w node-pty || true"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.48.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "com.sakai.app",
    "productName": "Sakai IDE",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server/dist-bundle",
        "to": "server"
      }
    ],
    "asarUnpack": [
      "**/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "icon": "build/icon.icns",
      "identity": null
    },
    "dmg": {
      "title": "Sakai IDE",
      "backgroundColor": "#0b0b0c"
    },
    "artifactName": "Sakai-IDE-${version}-${arch}.${ext}",
    "electronVersion": "44.4.5"
  },
  "author": "Sakai"
}
